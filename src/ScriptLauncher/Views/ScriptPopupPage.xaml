<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ScriptLauncher.ViewModels"
             x:Class="ScriptLauncher.Views.ScriptPopupPage"
             x:DataType="viewmodels:ScriptPopupViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="HeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="Gray"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

        <Style x:Key="StatusSuccessStyle" TargetType="Label">
            <Setter Property="TextColor" Value="Green"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

        <Style x:Key="StatusErrorStyle" TargetType="Label">
            <Setter Property="TextColor" Value="Red"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
            <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <Label Text="{Binding Title}" Style="{StaticResource HeaderStyle}"/>
            <Label Text="{Binding Script.UI.Subtitle}"
                   Style="{StaticResource SubtitleStyle}"
                   IsVisible="{Binding Script.UI.Subtitle, Converter={StaticResource IsNotNullConverter}}"/>
        </VerticalStackLayout>

        <!-- Dynamic Form Fields -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="FieldsContainer" Spacing="16">
                <!-- Fields will be added dynamically in code-behind -->
            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Message -->
        <Label Grid.Row="2"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding ShowStatus}"
               HorizontalOptions="Center"
               Margin="0,16,0,16">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="TextColor" Value="Green"/>
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="TextColor" Value="Red"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16">
            <Button Grid.Column="0"
                    Text="{Binding CancelButtonText}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="1"
                    Text="{Binding SubmitButtonText}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ExecuteCommand}"
                    IsEnabled="{Binding CanExecute}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExecuting}" Value="True">
                        <Setter Property="Text" Value="Executing..."/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsExecuting}">
            <ActivityIndicator IsRunning="{Binding IsExecuting}"
                               Color="White"
                               WidthRequest="50"
                               HeightRequest="50"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
